# Server
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=mongodb://localhost:27017/trythis
# Explicit database name. Required when DATABASE_URL omits the db (e.g. Atlas
# srv URIs ending in "/?..."), otherwise the app refuses to start rather than
# silently using the default "test" db. Production uses: wanna-try
MONGODB_DB=
MONGODB_USER=
MONGODB_PASSWORD=

# Cache
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRE=7d

# APIs
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Voice notes → structured memory (ADR 0016). Optional override of the model used
# to turn a transcript into who/where/about/remind-me.
CLAUDE_MEMORY_MODEL=claude-sonnet-4-6

# Google AI Studio key (Gemini) — used in Hindi OCR fallback and non-English transcript normalization
GEMINI_API_KEY=
# Sarvam speech for Hindi/Hinglish reel audio. Keep the real key only in .env.
# Primary endpoint is speech-to-text-translate (saaras): audio -> English in one
# call. Plain STT (saarika) is the fallback; 'unknown' lets it auto-detect the
# spoken language instead of mislabeling everything as Hindi.
SARVAM_API_KEY=
SARVAM_STT_TRANSLATE_URL=https://api.sarvam.ai/speech-to-text-translate
SARVAM_STT_TRANSLATE_MODEL=saaras:v2
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_STT_MODEL=saarika:v2
SARVAM_STT_LANGUAGE_CODE=unknown
# Monthly audio-seconds cap (shared by both endpoints). Usage is tracked in
# Mongo (UsageCounter) so deploys/restarts can't reset the budget.
SARVAM_MONTHLY_AUDIO_SECONDS_LIMIT=3600
# Optional: geocoding for day-wise trip plans. Without it, Maps search links still work.
GOOGLE_MAPS_API_KEY=
# Google CLOUD Vision (different product from Gemini): enable the Cloud Vision
# API in a GCP project, create a service account, download its JSON key, and
# point this at the file. Used only as the final fallback for handwritten
# Devanagari OCR while billing is disabled; the pipeline tries LLM OCR first.
# Keep the JSON file out of git.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/your-vision-key.json
# Monthly per-image cap to stay inside Vision's free tier (1,000/mo). Once
# reached, OCR falls back to the free LLM path instead of incurring charges.
# Usage is tracked in Mongo (UsageCounter), surviving deploys/restarts.
VISION_MONTHLY_LIMIT=700
# Minimum average line confidence (0-1) for Tesseract's printed-Devanagari OCR
# to be accepted before falling back to LLM OCR.
TESSERACT_MIN_CONFIDENCE=0.55

# Frontend
FRONTEND_URL=http://localhost:8081

# Queue
# Set both to true when pointing a local server at the production database, so
# it never takes production's upload jobs or runs media extraction locally.
DISABLE_UPLOAD_WORKER=false
ENABLE_MEDIA_PROCESSING=true
QUEUE_CONCURRENCY=5
QUEUE_MAX_ATTEMPTS=3

# Logging
LOG_LEVEL=debug

# Email (Notification Delivery)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your-mailtrap-user
SMTP_PASS=your-mailtrap-password
EMAIL_FROM=noreply@trythis.app
PUBLIC_BASE_URL=http://localhost:8081

# External-cron shared secret for POST /notifications/run (header x-cron-secret).
# Required in production: the in-process node-cron never fires on hosts that
# sleep when idle (Render free tier) — point cron-job.org / UptimeRobot / a
# GitHub Action at this endpoint 3x/day so the scheduler actually runs.
CRON_SECRET=

# Web Push (VAPID) — run: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Media pipeline
# yt-dlp self-updates on container start (docker-entrypoint.sh). Extractors break
# whenever a site changes; a build-time-pinned binary rots silently. Leave on.
YTDLP_AUTO_UPDATE=true
# Startup recovery for saves stranded mid-pipeline by a deploy/crash/idle-sleep.
DISABLE_STUCK_SAVE_RECOVERY=false
STUCK_SAVE_STALE_MINUTES=15
STUCK_SAVE_MAX_RECOVERED=25

# Geocoding — turns any place name into coordinates, cached permanently in Mongo
# so each distinct place costs one lookup ever. Without a Google key it uses
# OpenStreetMap's Nominatim, which is free and needs no key.
ENABLE_GEOCODING=true
GOOGLE_MAPS_API_KEY=
NOMINATIM_USER_AGENT=WannaTry/1.0 (+https://your-domain.example)

# Speech-to-text. Sarvam is tried first for Hindi/Hinglish (see AGENTS.md); when
# SARVAM_API_KEY is absent the pipeline silently falls back to Groq Whisper,
# which is markedly weaker on code-mixed Indian speech.
SARVAM_API_KEY=
GROQ_API_KEY=
# Defaults to whisper-large-v3. Set to whisper-large-v3-turbo only if you need
# speed more than accuracy — turbo is distilled and degrades most on Hindi.
GROQ_WHISPER_MODEL=whisper-large-v3
